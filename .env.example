NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=sms_service

REDIS_HOST=localhost
REDIS_PORT=6380

SMS_PROVIDER_PRIORITY=twilio,bird
SMS_MAX_RETRIES=3
SMS_RETRY_BASE_DELAY_MS=2000
SMS_IDEMPOTENCY_TTL_SECONDS=86400
SMS_MAX_MESSAGE_LENGTH=1600

# Retry of the queue job itself, applied by BullMQ when the worker fails for
# infrastructure reasons (Redis or PostgreSQL dropping mid-dispatch). This is
# separate from SMS_MAX_RETRIES, which retries the provider API call.
SMS_JOB_ATTEMPTS=3
SMS_JOB_BACKOFF_DELAY_MS=1000

TWILIO_RATE_LIMIT_MAX=10
TWILIO_RATE_LIMIT_DURATION_MS=1000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

BIRD_RATE_LIMIT_MAX=10
BIRD_RATE_LIMIT_DURATION_MS=1000
BIRD_API_KEY=
BIRD_ORIGINATOR=

# --- Delivery webhooks ---
# Public origin the providers call. It MUST match the exact scheme, host and port
# the provider was configured with: Twilio signs the full callback URL, so behind
# a TLS-terminating proxy this has to be the public HTTPS origin, not the
# internal one. Required in production; the default only fits local development.
PUBLIC_BASE_URL=http://localhost:3000

# Standard Webhooks signing secret of the Bird webhook subscription
# (whsec_ prefixed). This is NOT the Bird API key. Required only when the Bird
# webhook endpoint is in use; while empty every Bird callback is rejected.
BIRD_WEBHOOK_SECRET=

# Replay window for Bird deliveries, in seconds. Standard Webhooks defines 5
# minutes; a larger value here cannot widen the window enforced by the SDK.
BIRD_WEBHOOK_TOLERANCE_SECONDS=300

# How long a processed Bird webhook-id is remembered for deduplication.
WEBHOOK_IDEMPOTENCY_TTL_SECONDS=86400
